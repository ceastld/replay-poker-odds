{
  "manifest_version": 3,
  "name": "Replay Poker Odds Overlay",
  "version": "1.7.8",
  "description": "Auto-detect cards and estimate equity. Display-only bottom bar + special combo panel.",
  "content_scripts": [
    {
      "matches": [
        "https://www.casino.org/replaypoker/*",
        "https://www.replaypoker.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://www.casino.org/replaypoker/*",
    "https://www.replaypoker.com/*"
  ]
}
