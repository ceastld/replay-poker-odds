{
  "manifest_version": 3,
  "name": "Replay Poker 胜率浮层",
  "version": "1.1.0",
  "description": "自动识牌并估算胜率；仅显示，不代打",
  "content_scripts": [
    {
      "matches": [
        "https://www.casino.org/replaypoker/*",
        "https://www.replaypoker.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://www.casino.org/replaypoker/*",
    "https://www.replaypoker.com/*"
  ]
}
